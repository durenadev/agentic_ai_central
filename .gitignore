# The 6 sibling tool repos are NOT tracked here — setup.py clones them on
# first run via ensure_tool_repos_present(). Keeps the parent repo small
# and avoids embedded-git-repo / submodule complexity.
agentic_debug/
agentic_devdocs/
agentic_indexer/
agentic_orchestrator/
agentic_sitemap/
moodle_claude/

# Generated by setup.py — per-machine state, configs, built resources.
_data/

# Per-machine Claude Code overrides (committed settings.json is the baseline).
.claude/settings.local.json

# Python build / cache / test artefacts.
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
htmlcov/

# SQLite WAL/journal sidecars (the .db files themselves live under _data/).
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Setup.py uses .bak temp directories during submodule conversion — never commit them.
*.bak/

# Node — in case any sub-repo or generated config pulls it in.
node_modules/

# Toolchain pinning files (per-machine).
.python-version
.tool-versions

# OS / editor noise.
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
